expression a8101op_raw =
		let
		    Source =
		        Csv.Document(
		            File.Contents(CsvRootPath & "\A8101OP.csv"),
		            [
		                Delimiter = ";",
		                Encoding = 1252,
		                QuoteStyle = QuoteStyle.Csv
		            ]
		        ),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"%Keys", type text}, {"Firma", Int64.Type}, {"Betrieb", Int64.Type}, {"Kunde", Int64.Type}, {"Rechnung", Int64.Type}, {"lfdNr", Int64.Type}, {"Betrag [101]", Int64.Type}, {"Konto (Bank/Kasse) [102]", Int64.Type}, {"Datum (Valuta) [103]", Int64.Type}, {"KontoauszugNr [104]", type text}, {"Diff / Skonto [105]", type text}, {"Storno [106]", type text}, {"Stornotext [107]", type text}, {"Auftragsnummer [108]", Int64.Type}, {"Rechnungsdatum [109]", Int64.Type}, {"OP erledigt 0/1 [110]", Int64.Type}, {"Mitarbeiter-KZ [111]", type text}, {"Erfassungdatum [112]", Int64.Type}, {"Erfassungseit HH:MM:SS [113]", type time}, {"Nettowert [114]", Int64.Type}, {"Abzuege [115]", Int64.Type}, {"Bemerkung [116]", type text}, {"Storno Mitarbeiter [117]", type text}, {"Storno Zeit [118]", type text}, {"Fällig am [119]", Int64.Type}})
		in
		    #"Changed Type"
	lineageTag: 625ca506-c9b7-4a8a-8df7-d39a451b443b

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression a8101op =
		let
		    Source = a8101op_raw,
		
		    #"Changed Base Types" =
		        Table.TransformColumnTypes(
		            Source,
		            {
		                {"%Keys", type text},
		                {"Firma", Int64.Type},
		                {"Betrieb", Int64.Type},
		                {"Kunde", Int64.Type},
		                {"Rechnung", Int64.Type},
		                {"lfdNr", Int64.Type},
		
		                {"Betrag [101]", type number},
		                {"Konto (Bank/Kasse) [102]", Int64.Type},
		                {"Datum (Valuta) [103]", Int64.Type},
		                {"KontoauszugNr [104]", type text},
		                {"Diff / Skonto [105]", type number},
		                {"Storno [106]", type text},
		                {"Stornotext [107]", type text},
		                {"Auftragsnummer [108]", Int64.Type},
		                {"Rechnungsdatum [109]", Int64.Type},
		                {"OP erledigt 0/1 [110]", Int64.Type},
		                {"Mitarbeiter-KZ [111]", type text},
		                {"Erfassungdatum [112]", Int64.Type},
		                {"Erfassungseit HH:MM:SS [113]", type time},
		                {"Nettowert [114]", type number},
		                {"Abzuege [115]", type number},
		                {"Bemerkung [116]", type text},
		                {"Storno Mitarbeiter [117]", type text},
		                {"Storno Zeit [118]", type text},
		                {"Fällig am [119]", Int64.Type}
		            }
		        ),
		
		    ParseDate = (Value as nullable number) as nullable date =>
		        let
		            TextValue =
		                if Value = null
		                then ""
		                else Text.PadStart(Text.From(Value), 8, "0"),
		
		            Result =
		                if Text.Length(TextValue) <> 8 or Value = 0
		                then null
		                else
		                    try
		                        #date(
		                            Number.FromText(Text.Start(TextValue, 4)),
		                            Number.FromText(Text.Range(TextValue, 4, 2)),
		                            Number.FromText(Text.End(TextValue, 2))
		                        )
		                    otherwise
		                        null
		        in
		            Result,
		
		    #"Added ValueDate" =
		        Table.AddColumn(
		            #"Changed Base Types",
		            "ValueDate",
		            each ParseDate([#"Datum (Valuta) [103]"]),
		            type date
		        ),
		
		    #"Added InvoiceDate" =
		        Table.AddColumn(
		            #"Added ValueDate",
		            "InvoiceDate",
		            each ParseDate([#"Rechnungsdatum [109]"]),
		            type date
		        ),
		
		    #"Added EntryDate" =
		        Table.AddColumn(
		            #"Added InvoiceDate",
		            "EntryDate",
		            each ParseDate([#"Erfassungdatum [112]"]),
		            type date
		        ),
		
		    #"Added DueDate" =
		        Table.AddColumn(
		            #"Added EntryDate",
		            "DueDate",
		            each ParseDate([#"Fällig am [119]"]),
		            type date
		        ),
		
		    #"Added OpenItemKey" =
		        Table.AddColumn(
		            #"Added DueDate",
		            "OpenItemKey",
		            each
		                Text.From([Firma]) & "," &
		                Text.From([Betrieb]) & "," &
		                Text.From([Kunde]) & "," &
		                Text.From([Rechnung]),
		            type text
		        ),
		
		    #"Removed Raw Dates" =
		        Table.RemoveColumns(
		            #"Added OpenItemKey",
		            {
		                "Datum (Valuta) [103]",
		                "Rechnungsdatum [109]",
		                "Erfassungdatum [112]",
		                "Fällig am [119]"
		            }
		        ),
		
		     #"Added InvoiceKey" =
		        Table.AddColumn(
		            #"Removed Raw Dates",
		            "InvoiceKey",
		            each
		                Text.From([Firma]) & "," &
		                Text.From([Betrieb]) & "," &
		                Text.From([#"Auftragsnummer [108]"]) & "," &
		                Text.From([Rechnung]),
		            type text
		        )
		in
		    #"Added InvoiceKey"
	lineageTag: 9096f307-4be3-44a7-b80c-23304b70cdd0

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

