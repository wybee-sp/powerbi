/// Folder containing Power BI CSV exports
expression CsvRootPath = "D:\Entwicklung\PowerBI\Customers\999\Data" meta [IsParameterQuery=true, Type="Any", IsParameterQueryRequired=true]
	lineageTag: 6089f065-cb18-4250-a874-336fa4ddb665

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression a42001_raw =
		let
		    RootPath =
		        if Text.EndsWith(CsvRootPath, "\")
		        then CsvRootPath
		        else CsvRootPath & "\",
		
		    Source =
		        Csv.Document(
		            File.Contents(RootPath & "A42001.csv"),
		            [
		                Delimiter = ";",
		                Encoding = 1252,
		                QuoteStyle = QuoteStyle.Csv
		            ]
		        ),
		
		    #"Promoted Headers" =
		        Table.PromoteHeaders(
		            Source,
		            [PromoteAllScalars = true]
		        )
		in
		    #"Promoted Headers"
