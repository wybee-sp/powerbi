	partition 'Date' = calculated
		mode: import
		source =
				VAR SourceBounds =
				    UNION (
				        ROW ( "MinDate", MIN ( a42001[OrderDate] ), "MaxDate", MAX ( a42001[OrderDate] ) ),
				        ROW ( "MinDate", MIN ( a42001[ServiceDate] ), "MaxDate", MAX ( a42001[ServiceDate] ) ),
				        ROW ( "MinDate", MIN ( a42001[InvoiceDate] ), "MaxDate", MAX ( a42001[InvoiceDate] ) ),
				        ROW ( "MinDate", MIN ( a8101op_invoices[InvoiceDate] ), "MaxDate", MAX ( a8101op_invoices[InvoiceDate] ) ),
				        ROW ( "MinDate", MIN ( a8101op_invoices[DueDate] ), "MaxDate", MAX ( a8101op_invoices[DueDate] ) ),
				        ROW ( "MinDate", MIN ( a8101op_invoices[EntryDate] ), "MaxDate", MAX ( a8101op_invoices[EntryDate] ) ),
				        ROW ( "MinDate", MIN ( a8101op_invoices[ValueDate] ), "MaxDate", MAX ( a8101op_invoices[ValueDate] ) ),
				        ROW ( "MinDate", MIN ( a8101op_payments[InvoiceDate] ), "MaxDate", MAX ( a8101op_payments[InvoiceDate] ) ),
				        ROW ( "MinDate", MIN ( a8101op_payments[DueDate] ), "MaxDate", MAX ( a8101op_payments[DueDate] ) ),
				        ROW ( "MinDate", MIN ( a8101op_payments[EntryDate] ), "MaxDate", MAX ( a8101op_payments[EntryDate] ) ),
				        ROW ( "MinDate", MIN ( a8101op_payments[ValueDate] ), "MaxDate", MAX ( a8101op_payments[ValueDate] ) )
				    )
				VAR FirstDataDate = MINX ( SourceBounds, [MinDate] )
				VAR LastDataDate = MAXX ( SourceBounds, [MaxDate] )
				VAR RefreshDate = TODAY ()
				VAR FirstYear = YEAR ( MIN ( COALESCE ( FirstDataDate, RefreshDate ), RefreshDate ) )
				VAR LastYear = MIN ( 9999, YEAR ( MAX ( COALESCE ( LastDataDate, RefreshDate ), RefreshDate ) ) + 1 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( DATE ( FirstYear, 1, 1 ), DATE ( LastYear, 12, 31 ) ),
				        "Year", YEAR ( [Date] ),
				        "Quarter", "Q" & FORMAT ( QUARTER ( [Date] ), "0", "en-US" ),
				        "Quarter Number", QUARTER ( [Date] ),
				        "Month", FORMAT ( [Date], "MMMM", "en-US" ),
				        "Month Number", MONTH ( [Date] ),
				        "Year-Month", FORMAT ( [Date], "yyyy-MM", "en-US" ),
				        "Year-Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Day", DAY ( [Date] ),
				        "Day of Week", FORMAT ( [Date], "dddd", "en-US" ),
				        "Day of Week Number", WEEKDAY ( [Date], 2 ),
				        "Week", WEEKNUM ( [Date], 21 ),
				        "ISO Year", YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ),
				        "Year-Week", FORMAT ( YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ), "0000", "en-US" ) & "-W" & FORMAT ( WEEKNUM ( [Date], 21 ), "00", "en-US" ),
				        "Year-Week Sort", YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ) * 100 + WEEKNUM ( [Date], 21 )
				    )
